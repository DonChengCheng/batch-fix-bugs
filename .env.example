# 复制成 .env 后填自己的值。.env 已在 .gitignore 里，不会被提交。

# ── 禅道适配器 ──────────────────────────────────────────────
# zentao-cli.js 的绝对路径
ZENTAO_CLI=/absolute/path/to/zentao-cli.js

# ── GitHub 适配器 ───────────────────────────────────────────
# 目标仓库。工作流在 worktree 目录里调用适配器，不能靠 cwd 探测，必须显式指定。
GH_REPO=owner/repo

# ── mock 适配器（可选）──────────────────────────────────────
# 换成自己的 fixture 文件；默认用 adapters/fixtures/issues.json
# MOCK_FIXTURES=/absolute/path/to/your-fixtures.json
